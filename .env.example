# ==============================================================================
# .env.example — EletroLar Varejo (Pós-Venda e Suporte de Eletrodomésticos)
# ==============================================================================
# POLÍTICA ZERO-LEAK:
# NUNCA versione Account IDs reais de 12 dígitos, chaves AKIA/ASIA ou snippets
# reais neste arquivo. Copie para `.env` (ignorado pelo Git) para uso local.
# ==============================================================================

AWS_REGION=us-west-2
AWS_ACCOUNT_ID=000000000000

# Amazon Connect
CONNECT_INSTANCE_ALIAS=<INSTANCE_ALIAS>
CONNECT_INSTANCE_ID=<INSTANCE_ID>
CONNECT_QUEUE_N1_NAME=PV-Fila-Suporte-PosVenda-N1
CONNECT_WIDGET_ID=<WIDGET_ID>
CONNECT_WIDGET_SNIPPET=<WIDGET_SNIPPET>

# Amazon DynamoDB & S3 (Knowledge Base do Amazon Q in Connect)
DYNAMODB_TABLE=PV-AssistenciasGarantia
S3_KB_BUCKET=pv-kb-000000000000-us-west-2

# Amazon Lex V2 (pt_BR — Voz Neural Camila)
LEX_BOT_NAME=PV-EletroLar-Bot
LEX_BOT_ID=<LEX_BOT_ID>
LEX_BOT_ALIAS_ID=<LEX_BOT_ALIAS_ID>
LEX_LOCALE_ID=pt_BR

# Proteção FinOps do Widget na Vercel
MAX_WIDGET_MESSAGES_PER_VISITOR=30
